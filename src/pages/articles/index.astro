---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const articles = await getCollection('articles', ({ data }) => data.status === 'live' || data.status === 'approved');
articles.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const categories = ['all', 'cars', 'watches', 'gear', 'style', 'tech', 'books', 'art'];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title="Picks — The Cache"
  description="Gear, watches, cars, architecture, books, art, and culture worth your attention."
>
  <div class="page-outer">
    <div class="container">

      <!-- Page header -->
      <div class="page-header">
        <span class="page-kicker">The Archive</span>
        <h1 class="page-title">Every Pick.</h1>
        <p class="page-sub">Nothing average, nothing paid for. {articles.length} picks and counting.</p>
      </div>

      <!-- Category filter -->
      <div class="filter-bar" id="filterBar">
        {categories.map(cat => (
          <button
            class={`filter-btn ${cat === 'all' ? 'active' : ''}`}
            data-cat={cat}
          >
            {cat === 'all' ? 'All' : cat.charAt(0).toUpperCase() + cat.slice(1)}
          </button>
        ))}
      </div>

      <!-- Article list -->
      {articles.length > 0 ? (
        <div class="picks-list" id="picksGrid">
          {articles.map(article => (
            <a
              href={`/articles/${article.slug}`}
              class="pick-row"
              data-cat={article.data.category.toLowerCase()}
            >
              <div class="pick-row-image">
                {article.data.image ? (
                  <img src={article.data.image} alt={article.data.title} loading="lazy" />
                ) : (
                  <div class="img-placeholder"></div>
                )}
              </div>
              <div class="pick-row-body">
                <span class="cat-label">{article.data.category}</span>
                <h2 class="pick-row-title">{article.data.title}</h2>
                <p class="pick-row-excerpt">{article.data.description}</p>
                <div class="pick-row-foot">
                  <span class="pick-row-date">{formatDate(article.data.publishedDate)}</span>
                  {article.data.price && <span class="pick-row-price">{article.data.price}</span>}
                  <span class="pick-row-cta">Read &rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">First picks dropping soon. Check back.</p>
      )}

    </div>
  </div>
</BaseLayout>

<script>
  const filterBar = document.getElementById('filterBar');
  const picksGrid = document.getElementById('picksGrid');

  if (filterBar && picksGrid) {
    filterBar.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLButtonElement | null;
      if (!btn) return;

      const cat = btn.dataset.cat;

      filterBar.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      picksGrid.querySelectorAll<HTMLElement>('.pick-row').forEach(card => {
        if (cat === 'all' || card.dataset.cat === cat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>

<style>
  .page-outer {
    padding: 4rem 0 5rem;
    background: var(--brand-surface);
  }

  /* ── Page header ───────────────────────────── */
  .page-header {
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--brand-text);
    margin-bottom: 2rem;
  }

  .page-kicker {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin-bottom: 1rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--brand-text);
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  .page-sub {
    font-size: 0.9375rem;
    color: var(--brand-text-secondary);
    line-height: 1.6;
    max-width: 480px;
  }

  /* ── Filter bar ────────────────────────────── */
  .filter-bar {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.4rem 1rem;
    border: 1px solid var(--brand-border-strong);
    background: transparent;
    color: var(--brand-muted);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.15s;
  }

  .filter-btn:hover {
    border-color: var(--brand-text);
    color: var(--brand-text);
    background: transparent;
  }

  .filter-btn.active {
    background: var(--brand-text);
    border-color: var(--brand-text);
    color: white;
  }

  /* ── Picks list ────────────────────────────── */
  .picks-list {
    display: flex;
    flex-direction: column;
  }

  .pick-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.75rem;
    align-items: start;
    padding: 2rem 0;
    border-bottom: 1px solid var(--brand-border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .pick-row:first-child {
    border-top: 1px solid var(--brand-border);
  }

  .pick-row-image {
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--brand-surface-2);
    flex-shrink: 0;
  }

  .pick-row-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pick-row:hover .pick-row-image img {
    transform: scale(1.05);
  }

  .img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--brand-surface-2);
  }

  .pick-row-body {
    display: flex;
    flex-direction: column;
    padding-top: 0.25rem;
  }

  .cat-label {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--brand-accent);
    margin-bottom: 0.6rem;
  }

  .pick-row-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--brand-text);
    margin-bottom: 0.6rem;
    transition: color 0.15s;
  }

  .pick-row:hover .pick-row-title {
    color: var(--brand-accent);
  }

  .pick-row-excerpt {
    font-size: 0.875rem;
    color: var(--brand-text-secondary);
    line-height: 1.65;
    margin-bottom: 0.875rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pick-row-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .pick-row-date {
    font-size: 0.7rem;
    color: var(--brand-muted);
    letter-spacing: 0.03em;
  }

  .pick-row-price {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-accent);
  }

  .pick-row-cta {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--brand-muted);
    letter-spacing: 0.04em;
    margin-left: auto;
    transition: color 0.15s;
  }

  .pick-row:hover .pick-row-cta {
    color: var(--brand-accent);
  }

  /* ── Empty / shared ─────────────────────────── */
  .empty-state {
    color: var(--brand-muted);
    font-style: italic;
    padding: 3rem 0;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 700px) {
    .page-outer { padding: 2.5rem 0 4rem; }

    .pick-row {
      grid-template-columns: 100px 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .pick-row {
      grid-template-columns: 1fr;
    }

    .pick-row-image {
      aspect-ratio: 16/9;
    }
  }
</style>
