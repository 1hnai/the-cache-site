---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'live' || data.status === 'approved');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const { title, description, category, publishedDate, image, gallery, price, buyUrl } = article.data;
const allImages = gallery && gallery.length > 0 ? gallery : (image ? [image] : []);

const formattedDate = new Date(publishedDate).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<BaseLayout title={title} description={description} article={true} publishedDate={publishedDate}>
  <div class="article-outer">
    <article class="article-wrap">

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/articles" class="breadcrumb-link">All Picks</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-cat">{category}</span>
      </div>

      <!-- Article header -->
      <header class="article-header">
        <span class="cat-label">{category}</span>
        <h1 class="article-title">{title}</h1>
        <p class="article-date">{formattedDate}</p>
      </header>

      <!-- Buy strip -->
      {price && buyUrl && (
        <div class="buy-strip">
          <span class="buy-price">{price}</span>
          <a href={buyUrl} class="buy-btn" target="_blank" rel="noopener noreferrer">Buy Now &rarr;</a>
        </div>
      )}

      <!-- Hero image + gallery -->
      {allImages.length > 0 ? (
        <div class="image-block">
          <div class="hero-image">
            <img src={allImages[0]} alt={title} />
          </div>
          {allImages.length > 1 && (
            <div class="image-gallery">
              {allImages.slice(1).map((src, i) => (
                <div class="gallery-item">
                  <img src={src} alt={`${title} — view ${i + 2}`} />
                </div>
              ))}
            </div>
          )}
        </div>
      ) : (
        <div class="hero-image-placeholder"></div>
      )}

      <!-- Article body -->
      <div class="article-body">
        <Content />
      </div>

      <!-- Footer buy strip (if product) -->
      {price && buyUrl && (
        <div class="article-footer-buy">
          <div class="footer-buy-inner">
            <div>
              <span class="footer-buy-label">Purchase</span>
              <span class="footer-buy-price">{price}</span>
            </div>
            <a href={buyUrl} class="footer-buy-btn" target="_blank" rel="noopener noreferrer">Buy Now &rarr;</a>
          </div>
        </div>
      )}

    </article>
  </div>
</BaseLayout>

<style>
  .article-outer {
    background: var(--brand-surface);
    padding: 3rem 2rem 5rem;
  }

  .article-wrap {
    max-width: var(--reading-width);
    margin: 0 auto;
  }

  /* ── Breadcrumb ────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    margin-bottom: 2rem;
  }

  .breadcrumb-link {
    color: var(--brand-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    transition: color 0.15s;
  }

  .breadcrumb-link:hover { color: var(--brand-text); }

  .breadcrumb-sep {
    color: var(--brand-border-strong);
  }

  .breadcrumb-cat {
    color: var(--brand-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  /* ── Article header ────────────────────────── */
  .article-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--brand-border);
    margin-bottom: 2rem;
  }

  .cat-label {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--brand-accent);
    margin-bottom: 1rem;
  }

  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: var(--brand-text);
    margin-bottom: 1rem;
  }

  .article-date {
    font-size: 0.8rem;
    color: var(--brand-muted);
    letter-spacing: 0.03em;
  }

  /* ── Buy strip (top) ───────────────────────── */
  .buy-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--brand-border);
    background: var(--brand-bg);
  }

  .buy-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brand-text);
  }

  .buy-btn {
    padding: 0.5rem 1.25rem;
    background: var(--brand-accent);
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .buy-btn:hover {
    background: var(--brand-accent-hover);
    color: white;
  }

  /* ── Images ─────────────────────────────────── */
  .image-block {
    margin-bottom: 2.5rem;
  }

  .hero-image {
    overflow: hidden;
    background: var(--brand-surface-2);
    margin-bottom: 0.75rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 520px;
    object-fit: cover;
    object-position: center;
  }

  .image-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  .gallery-item {
    overflow: hidden;
    background: var(--brand-surface-2);
  }

  .gallery-item img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item img:hover {
    transform: scale(1.03);
  }

  .hero-image-placeholder {
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--brand-surface-2);
    margin-bottom: 2.5rem;
  }

  /* ── Article body ──────────────────────────── */
  .article-body :global(p) {
    margin-bottom: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.82;
    color: var(--brand-text);
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--brand-text);
  }

  .article-body :global(h3) {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 2rem 0 0.5rem;
    color: var(--brand-text);
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0.5rem 0 1.35rem 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--brand-text);
  }

  .article-body :global(strong) {
    font-weight: 700;
    color: var(--brand-text);
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--brand-border);
    margin: 2.5rem 0;
  }

  .article-body :global(a) {
    color: var(--brand-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    color: var(--brand-accent-hover);
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--brand-accent);
    padding-left: 1.25rem;
    color: var(--brand-text-secondary);
    margin: 1.5rem 0;
    font-style: italic;
  }

  /* ── Footer buy (bottom) ───────────────────── */
  .article-footer-buy {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--brand-border);
  }

  .footer-buy-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-buy-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.25rem;
  }

  .footer-buy-price {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-text);
    font-family: var(--font-serif);
  }

  .footer-buy-btn {
    padding: 0.75rem 2rem;
    background: var(--brand-text);
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
  }

  .footer-buy-btn:hover {
    background: var(--brand-accent);
    color: white;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .article-outer { padding: 2rem 1.25rem 4rem; }
    .footer-buy-inner { flex-direction: column; align-items: flex-start; }
    .footer-buy-btn { width: 100%; text-align: center; }
  }
</style>
