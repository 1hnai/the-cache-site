---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status === 'live' || data.status === 'approved');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const { title, description, category, publishedDate, image, gallery, price, buyUrl } = article.data;
const allImages = gallery && gallery.length > 0 ? gallery : (image ? [image] : []);

const formattedDate = new Date(publishedDate).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric'
});
---

<BaseLayout title={title} description={description} article={true} publishedDate={publishedDate}>
  <div class="article-outer">
    <article class="article-wrap">

      <!-- Breadcrumb -->
      <div class="breadcrumb">
        <a href="/articles" class="breadcrumb-link">All Picks</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-cat">{category}</span>
      </div>

      <!-- Article header -->
      <header class="article-header">
        <span class="cat-label">{category}</span>
        <h1 class="article-title">{title}</h1>
        <p class="article-date">{formattedDate}</p>
      </header>

      <!-- Buy strip -->
      {price && buyUrl && (
        <div class="buy-strip">
          <span class="buy-price">{price}</span>
          <a href={buyUrl} class="buy-btn" target="_blank" rel="noopener noreferrer">Buy Now &rarr;</a>
        </div>
      )}

      <!-- Image gallery -->
      {allImages.length > 0 && (
        <div class="gallery-wrap" id="gallery">
          <!-- Main image viewer -->
          <div class="main-image-frame">
            <img
              id="main-img"
              src={allImages[0]}
              alt={title}
              class="main-img"
            />
          </div>

          <!-- Thumbnails (only shown if >1 image) -->
          {allImages.length > 1 && (
            <div class="thumb-row">
              {allImages.map((src, i) => (
                <button
                  class={`thumb-btn${i === 0 ? ' active' : ''}`}
                  data-src={src}
                  data-index={i}
                  aria-label={`View image ${i + 1}`}
                >
                  <img src={src} alt={`${title} — view ${i + 1}`} />
                </button>
              ))}
            </div>
          )}
        </div>
      )}

      <!-- Article body -->
      <div class="article-body">
        <Content />
      </div>

      <!-- Footer buy strip -->
      {price && buyUrl && (
        <div class="article-footer-buy">
          <div class="footer-buy-inner">
            <div>
              <span class="footer-buy-label">Purchase</span>
              <span class="footer-buy-price">{price}</span>
            </div>
            <a href={buyUrl} class="footer-buy-btn" target="_blank" rel="noopener noreferrer">Buy Now &rarr;</a>
          </div>
        </div>
      )}

    </article>
  </div>
</BaseLayout>

<script>
  const mainImg = document.getElementById('main-img') as HTMLImageElement | null;
  const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.src;
      if (mainImg && src) {
        mainImg.src = src;
        mainImg.alt = btn.querySelector('img')?.alt ?? '';
      }
      thumbBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
</script>

<style>
  .article-outer {
    background: var(--brand-surface);
    padding: 3rem 2rem 5rem;
  }

  .article-wrap {
    max-width: var(--reading-width);
    margin: 0 auto;
  }

  /* ── Breadcrumb ────────────────────────────── */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    margin-bottom: 2rem;
  }
  .breadcrumb-link {
    color: var(--brand-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    transition: color 0.15s;
  }
  .breadcrumb-link:hover { color: var(--brand-text); }
  .breadcrumb-sep { color: var(--brand-border-strong); }
  .breadcrumb-cat {
    color: var(--brand-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  /* ── Article header ────────────────────────── */
  .article-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--brand-border);
    margin-bottom: 2rem;
  }
  .cat-label {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--brand-accent);
    margin-bottom: 1rem;
  }
  .article-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: var(--brand-text);
    margin-bottom: 1rem;
  }
  .article-date {
    font-size: 0.8rem;
    color: var(--brand-muted);
    letter-spacing: 0.03em;
  }

  /* ── Buy strip (top) ───────────────────────── */
  .buy-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--brand-border);
    background: var(--brand-bg);
  }
  .buy-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--brand-text);
  }
  .buy-btn {
    padding: 0.5rem 1.25rem;
    background: var(--brand-accent);
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .buy-btn:hover { background: var(--brand-accent-hover); color: white; }

  /* ── Gallery ─────────────────────────────────── */
  .gallery-wrap {
    margin-bottom: 2.5rem;
  }

  /* Main image: white background, full image visible, no cropping */
  .main-image-frame {
    background: #fff;
    border: 1px solid var(--brand-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    min-height: 320px;
    max-height: 580px;
    overflow: hidden;
  }
  .main-img {
    max-width: 100%;
    max-height: 520px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: opacity 0.2s ease;
  }

  /* Thumbnail strip */
  .thumb-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.625rem;
    flex-wrap: wrap;
  }
  .thumb-btn {
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid var(--brand-border);
    background: #fff;
    cursor: pointer;
    overflow: hidden;
    flex-shrink: 0;
    transition: border-color 0.15s;
  }
  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .thumb-btn:hover { border-color: var(--brand-muted); }
  .thumb-btn.active { border-color: var(--brand-accent); }

  /* ── Article body ──────────────────────────── */
  .article-body :global(p) {
    margin-bottom: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.82;
    color: var(--brand-text);
  }
  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2.5rem 0 0.75rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--brand-text);
  }
  .article-body :global(h3) {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 2rem 0 0.5rem;
    color: var(--brand-text);
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0.5rem 0 1.35rem 1.5rem;
  }
  .article-body :global(li) {
    margin-bottom: 0.4rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--brand-text);
  }
  .article-body :global(strong) {
    font-weight: 700;
    color: var(--brand-text);
  }
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--brand-border);
    margin: 2.5rem 0;
  }
  .article-body :global(a) {
    color: var(--brand-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .article-body :global(a:hover) { color: var(--brand-accent-hover); }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--brand-accent);
    padding-left: 1.25rem;
    color: var(--brand-text-secondary);
    margin: 1.5rem 0;
    font-style: italic;
  }

  /* ── Footer buy ────────────────────────────── */
  .article-footer-buy {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--brand-border);
  }
  .footer-buy-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .footer-buy-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-muted);
    margin-bottom: 0.25rem;
  }
  .footer-buy-price {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-text);
    font-family: var(--font-serif);
  }
  .footer-buy-btn {
    padding: 0.75rem 2rem;
    background: var(--brand-text);
    color: white;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .footer-buy-btn:hover { background: var(--brand-accent); color: white; }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 768px) {
    .article-outer { padding: 2rem 1.25rem 4rem; }
    .main-image-frame { min-height: 220px; max-height: 400px; padding: 1rem; }
    .main-img { max-height: 360px; }
    .footer-buy-inner { flex-direction: column; align-items: flex-start; }
    .footer-buy-btn { width: 100%; text-align: center; }
  }
</style>
