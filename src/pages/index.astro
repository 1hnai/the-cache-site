---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles', ({ data }) => data.status === 'live' || data.status === 'approved');
articles.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const featured = articles.find(a => a.data.featured) || articles[0];
const rest = articles.filter(a => a !== featured).slice(0, 6);
---

<BaseLayout
  title="The Cache"
  description="The best stuff you didn't know you needed. Curated picks across gear, tech, style, cars, and drinks."
>
  <!-- Hero bar -->
  <div class="hero-bar">
    <div class="container">
      <span class="hero-kicker">Men's Gear &amp; Lifestyle</span>
      <h1 class="hero-headline">The best stuff you<br />didn't know you needed.</h1>
      <p class="hero-sub">Curated picks across gear, tech, style, cars, and drinks — nothing paid for, nothing average.</p>
    </div>
  </div>

  <!-- Featured item -->
  {featured && (
    <div class="featured-wrap">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Featured Pick</span>
        </div>
        <a href={`/articles/${featured.slug}`} class="featured-card">
          <div class="featured-image">
            {featured.data.image ? (
              <img src={featured.data.image} alt={featured.data.title} loading="eager" />
            ) : (
              <div class="image-placeholder"></div>
            )}
            <div class="featured-overlay"></div>
          </div>
          <div class="featured-body">
            <span class="card-cat">{featured.data.category}</span>
            <h2 class="featured-title">{featured.data.title}</h2>
            <p class="featured-desc">{featured.data.description}</p>
            <div class="featured-footer">
              {featured.data.price && <span class="featured-price">{featured.data.price}</span>}
              <span class="featured-cta">View Pick &rarr;</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  )}

  <!-- Latest picks grid -->
  <div class="picks-wrap">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Latest Picks</span>
        <a href="/articles" class="view-all">View all &rarr;</a>
      </div>

      {rest.length > 0 ? (
        <div class="picks-grid">
          {rest.map(article => (
            <a href={`/articles/${article.slug}`} class="pick-card">
              <div class="pick-image">
                {article.data.image ? (
                  <img src={article.data.image} alt={article.data.title} loading="lazy" />
                ) : (
                  <div class="image-placeholder"></div>
                )}
                <div class="pick-overlay"></div>
              </div>
              <div class="pick-body">
                <span class="card-cat">{article.data.category}</span>
                <h3 class="pick-title">{article.data.title}</h3>
                <p class="pick-desc">{article.data.description}</p>
                {article.data.price && <span class="pick-price">{article.data.price}</span>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">First picks dropping soon. Check back.</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────── */
  .hero-bar {
    background: var(--brand-bg);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--brand-border);
  }

  .hero-kicker {
    display: block;
    font-size: 0.675rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--brand-text);
    margin-bottom: 1.25rem;
    max-width: 680px;
  }

  .hero-sub {
    font-size: 1rem;
    color: var(--brand-text-secondary);
    max-width: 500px;
    line-height: 1.7;
  }

  /* ── Section headers ─────────────────────── */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--brand-border);
    margin-bottom: 1.5rem;
  }

  .section-label {
    font-size: 0.675rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--brand-muted);
  }

  .view-all {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--brand-accent);
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }

  .view-all:hover { color: var(--brand-accent-hover); }

  /* ── Featured card ───────────────────────── */
  .featured-wrap {
    padding: 3rem 0;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    border: 1px solid var(--brand-border);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
    background: var(--brand-surface);
  }

  .featured-card:hover {
    border-color: var(--brand-border-strong);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
  }

  .featured-image {
    position: relative;
    aspect-ratio: 3/2;
    overflow: hidden;
    background: var(--brand-surface-2);
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .featured-card:hover .featured-image img {
    transform: scale(1.04);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 60%, rgba(17,17,17,0.2));
    pointer-events: none;
  }

  .featured-body {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--brand-surface);
  }

  .card-cat {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--brand-accent);
    margin-bottom: 0.75rem;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--brand-text);
    margin-bottom: 1rem;
  }

  .featured-desc {
    font-size: 0.9375rem;
    color: var(--brand-text-secondary);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-price {
    font-size: 1rem;
    font-weight: 600;
    color: var(--brand-text);
  }

  .featured-cta {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--brand-accent);
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }

  .featured-card:hover .featured-cta {
    color: var(--brand-accent-hover);
  }

  /* ── Picks grid ──────────────────────────── */
  .picks-wrap {
    padding: 0 0 4rem;
  }

  .picks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .pick-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--brand-border);
    border-radius: 5px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--brand-surface);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .pick-card:hover {
    border-color: var(--brand-border-strong);
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.35);
    transform: translateY(-2px);
  }

  .pick-image {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--brand-surface-2);
  }

  .pick-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pick-card:hover .pick-image img {
    transform: scale(1.05);
  }

  .pick-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,10,0.3) 0%, transparent 50%);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .pick-card:hover .pick-overlay {
    opacity: 1;
  }

  .pick-body {
    padding: 1.125rem 1.25rem 1.375rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .pick-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--brand-text);
    margin-bottom: 0.5rem;
    margin-top: 0.25rem;
    transition: color 0.15s;
  }

  .pick-card:hover .pick-title {
    color: var(--brand-accent);
  }

  .pick-desc {
    font-size: 0.8125rem;
    color: var(--brand-text-secondary);
    line-height: 1.55;
    flex: 1;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pick-price {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand-muted);
  }

  /* ── Shared ──────────────────────────────── */
  .image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--brand-surface-2);
  }

  .empty-state {
    color: var(--brand-muted);
    font-style: italic;
    padding: 3rem 0;
  }

  /* ── Responsive ──────────────────────────── */
  @media (max-width: 900px) {
    .featured-card { grid-template-columns: 1fr; }
    .featured-image { aspect-ratio: 16/9; }
    .featured-body { padding: 1.75rem; }
    .picks-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .hero-bar { padding: 3rem 0 2.5rem; }
    .picks-grid { grid-template-columns: 1fr; }
    .featured-wrap, .picks-wrap { padding-top: 2rem; }
  }
</style>
