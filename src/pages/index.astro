---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles', ({ data }) => data.status === 'live' || data.status === 'approved');
articles.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const featured = articles.find(a => a.data.featured) || articles[0];
const rest = articles.filter(a => a !== featured).slice(0, 6);

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title="The Cache"
  description="Curated editorial picks across gear, watches, cars, architecture, books, art, and culture."
>

  <!-- Masthead -->
  <div class="masthead">
    <div class="container">
      <p class="masthead-tagline">Gear · Watches · Cars · Architecture · Books · Art · Culture</p>
      <h1 class="masthead-headline">The best stuff you<br />didn't know you needed.</h1>
      <p class="masthead-sub">Short, sharp editorial picks. A friend with impeccable taste telling you about something worth knowing.</p>
    </div>
  </div>

  <!-- Divider rule -->
  <div class="container"><hr class="rule" /></div>

  <!-- Featured piece -->
  {featured && (
    <div class="featured-section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Featured</span>
          <a href="/articles" class="view-all">All picks &rarr;</a>
        </div>
        <a href={`/articles/${featured.slug}`} class="featured-link">
          <div class="featured-layout">
            <div class="featured-image-wrap">
              {featured.data.image ? (
                <img src={featured.data.image} alt={featured.data.title} loading="eager" class="featured-img" />
              ) : (
                <div class="img-placeholder featured-img-placeholder"></div>
              )}
            </div>
            <div class="featured-body">
              <span class="cat-label">{featured.data.category}</span>
              <h2 class="featured-title">{featured.data.title}</h2>
              <p class="featured-excerpt">{featured.data.description}</p>
              <div class="featured-foot">
                {featured.data.price && <span class="price-tag">{featured.data.price}</span>}
                <span class="read-link">Read &rarr;</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  )}

  <!-- Recent picks -->
  {rest.length > 0 && (
    <div class="picks-section">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Recent Picks</span>
        </div>
        <div class="picks-grid">
          {rest.map(article => (
            <a href={`/articles/${article.slug}`} class="pick-item">
              <div class="pick-image-wrap">
                {article.data.image ? (
                  <img src={article.data.image} alt={article.data.title} loading="lazy" class="pick-img" />
                ) : (
                  <div class="img-placeholder pick-img-placeholder"></div>
                )}
              </div>
              <div class="pick-body">
                <span class="cat-label">{article.data.category}</span>
                <h3 class="pick-title">{article.data.title}</h3>
                <p class="pick-excerpt">{article.data.description}</p>
                <div class="pick-foot">
                  <span class="pick-date">{formatDate(article.data.publishedDate)}</span>
                  {article.data.price && <span class="price-tag">{article.data.price}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
        <div class="all-picks-cta">
          <a href="/articles" class="all-picks-link">View all picks &rarr;</a>
        </div>
      </div>
    </div>
  )}

  {articles.length === 0 && (
    <div class="container empty-state">
      <p>First picks dropping soon. Check back.</p>
    </div>
  )}

</BaseLayout>

<style>
  /* ── Masthead ───────────────────────────────── */
  .masthead {
    padding: 5rem 0 4rem;
    background: var(--brand-surface);
    border-bottom: 1px solid var(--brand-border);
  }

  .masthead-tagline {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin-bottom: 1.5rem;
  }

  .masthead-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--brand-text);
    margin-bottom: 1.5rem;
    max-width: 720px;
  }

  .masthead-sub {
    font-size: 1rem;
    color: var(--brand-text-secondary);
    max-width: 480px;
    line-height: 1.7;
  }

  /* ── Rule ───────────────────────────────────── */
  .rule {
    border: none;
    border-top: 1px solid var(--brand-border);
    margin: 0;
  }

  /* ── Section headers ────────────────────────── */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--brand-text);
    margin-bottom: 2rem;
  }

  .section-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--brand-text);
  }

  .view-all {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--brand-accent);
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }

  .view-all:hover { color: var(--brand-accent-hover); }

  /* ── Category label ─────────────────────────── */
  .cat-label {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--brand-accent);
    margin-bottom: 0.75rem;
  }

  /* ── Featured section ───────────────────────── */
  .featured-section {
    padding: 3.5rem 0;
    background: var(--brand-surface);
  }

  .featured-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .featured-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .featured-image-wrap {
    overflow: hidden;
    aspect-ratio: 3/2;
    background: var(--brand-surface-2);
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .featured-link:hover .featured-img {
    transform: scale(1.03);
  }

  .featured-img-placeholder {
    width: 100%;
    height: 100%;
  }

  .featured-body {
    padding: 1rem 0;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.5vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--brand-text);
    margin-bottom: 1rem;
    transition: color 0.15s;
  }

  .featured-link:hover .featured-title {
    color: var(--brand-accent);
  }

  .featured-excerpt {
    font-size: 1rem;
    color: var(--brand-text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .featured-foot {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .price-tag {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand-text);
    letter-spacing: 0.02em;
  }

  .read-link {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--brand-accent);
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }

  .featured-link:hover .read-link {
    color: var(--brand-accent-hover);
  }

  /* ── Picks section ──────────────────────────── */
  .picks-section {
    padding: 3.5rem 0 4rem;
    background: var(--brand-bg);
    border-top: 1px solid var(--brand-border);
  }

  .picks-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .pick-item {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--brand-border);
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    align-items: start;
    transition: background 0.15s;
  }

  .pick-item:nth-child(odd) {
    padding-right: 2.5rem;
    border-right: 1px solid var(--brand-border);
  }

  .pick-item:nth-child(even) {
    padding-left: 2.5rem;
  }

  .pick-item:hover {
    background: transparent;
  }

  .pick-image-wrap {
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--brand-surface-2);
    flex-shrink: 0;
  }

  .pick-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pick-item:hover .pick-img {
    transform: scale(1.05);
  }

  .pick-img-placeholder {
    width: 100%;
    height: 100%;
  }

  .pick-body {
    display: flex;
    flex-direction: column;
  }

  .pick-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--brand-text);
    margin-bottom: 0.5rem;
    transition: color 0.15s;
  }

  .pick-item:hover .pick-title {
    color: var(--brand-accent);
  }

  .pick-excerpt {
    font-size: 0.8125rem;
    color: var(--brand-text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pick-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .pick-date {
    font-size: 0.7rem;
    color: var(--brand-muted);
    letter-spacing: 0.03em;
  }

  /* ── All picks CTA ──────────────────────────── */
  .all-picks-cta {
    padding-top: 2.5rem;
    text-align: center;
  }

  .all-picks-link {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-text);
    border-bottom: 1px solid var(--brand-text);
    padding-bottom: 2px;
    transition: color 0.15s, border-color 0.15s;
  }

  .all-picks-link:hover {
    color: var(--brand-accent);
    border-color: var(--brand-accent);
  }

  /* ── Shared ─────────────────────────────────── */
  .img-placeholder {
    background: var(--brand-surface-2);
  }

  .empty-state {
    padding: 4rem 0;
    color: var(--brand-muted);
    font-style: italic;
  }

  /* ── Responsive ─────────────────────────────── */
  @media (max-width: 900px) {
    .featured-layout {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .featured-image-wrap {
      aspect-ratio: 16/9;
    }

    .picks-grid {
      grid-template-columns: 1fr;
    }

    .pick-item:nth-child(odd) {
      padding-right: 0;
      border-right: none;
    }

    .pick-item:nth-child(even) {
      padding-left: 0;
    }
  }

  @media (max-width: 600px) {
    .masthead { padding: 3rem 0 2.5rem; }
    .featured-section { padding: 2.5rem 0; }
    .picks-section { padding: 2.5rem 0 3rem; }

    .pick-item {
      grid-template-columns: 90px 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 400px) {
    .pick-item {
      grid-template-columns: 1fr;
    }

    .pick-image-wrap {
      aspect-ratio: 16/9;
    }
  }
</style>
