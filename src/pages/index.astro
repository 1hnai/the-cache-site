---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles', ({ data }) => data.status === 'live' || data.status === 'approved');
articles.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const featured = articles.find(a => a.data.featured) || articles[0];
const recent = articles.filter(a => a !== featured).slice(0, 6);

function shortDate(d: string) {
  return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<BaseLayout
  title="The Cache"
  description="Curated editorial picks across gear, watches, cars, tech, style and culture. The best stuff you didn't know you needed."
>

  <!-- ── HERO ───────────────────────────────────────── -->
  {featured && (
    <section class="hero">
      <a href={`/articles/${featured.slug}`} class="hero-link">
        <div class="hero-image-wrap">
          {featured.data.image
            ? <img src={featured.data.image} alt={featured.data.title} class="hero-img" loading="eager" />
            : <div class="hero-img-placeholder"></div>
          }
          <div class="hero-overlay"></div>
        </div>
        <div class="hero-content">
          <div class="hero-content-inner">
            <span class="hero-eyebrow">{featured.data.category}</span>
            <h1 class="hero-title">{featured.data.title}</h1>
            <p class="hero-excerpt">{featured.data.description}</p>
            <div class="hero-meta">
              {featured.data.price && <span class="hero-price">{featured.data.price}</span>}
              <span class="hero-cta">Read the pick &rarr;</span>
            </div>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- ── SECTION HEADER ─────────────────────────────── -->
  <div class="section-rule">
    <div class="container">
      <div class="section-rule-inner">
        <span class="section-rule-label">Recent Picks</span>
        <a href="/articles" class="section-rule-link">All picks &rarr;</a>
      </div>
    </div>
  </div>

  <!-- ── PICKS GRID ─────────────────────────────────── -->
  {recent.length > 0 && (
    <section class="picks">
      <div class="container">
        <div class="picks-grid">
          {recent.map((article, i) => (
            <a href={`/articles/${article.slug}`} class={`pick-card ${i === 0 ? 'pick-card--wide' : ''}`}>
              <div class="pick-image-wrap">
                {article.data.image
                  ? <img src={article.data.image} alt={article.data.title} class="pick-img" loading="lazy" />
                  : <div class="pick-img-placeholder"></div>
                }
              </div>
              <div class="pick-body">
                <span class="pick-cat">{article.data.category}</span>
                <h2 class="pick-title">{article.data.title}</h2>
                <p class="pick-desc">{article.data.description}</p>
                <div class="pick-foot">
                  <span class="pick-date">{shortDate(article.data.publishedDate)}</span>
                  {article.data.price && <span class="pick-price">{article.data.price}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>

        <div class="all-cta">
          <a href="/articles" class="all-cta-link">
            <span>View all picks</span>
            <span class="all-cta-arrow">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── HERO ──────────────────────────────────────── */
  .hero {
    position: relative;
    width: 100%;
    height: clamp(480px, 72vh, 780px);
    overflow: hidden;
    background: var(--surface);
  }

  .hero-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .hero-image-wrap {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s ease;
  }

  .hero-link:hover .hero-img {
    transform: scale(1.04);
  }

  .hero-img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--surface-2);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(10,10,10,0.92) 0%,
      rgba(10,10,10,0.75) 45%,
      rgba(10,10,10,0.25) 75%,
      rgba(10,10,10,0.1) 100%
    );
  }

  .hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  .hero-content-inner {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
    max-width: 620px;
    padding-left: clamp(1.25rem, 5vw, 4rem);
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
    border: 1px solid var(--accent);
    padding: 0.3rem 0.75rem;
  }

  .hero-title {
    font-family: var(--serif);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
    max-width: 520px;
  }

  .hero-excerpt {
    font-size: 1rem;
    color: rgba(240,236,230,0.7);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 440px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-price {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    font-family: var(--serif);
  }

  .hero-cta {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 0.15s;
  }

  .hero-link:hover .hero-cta {
    color: var(--accent-alt);
  }

  /* ── SECTION RULE ──────────────────────────────── */
  .section-rule {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 1.1rem 0;
    background: var(--surface);
  }

  .section-rule-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .section-rule-label {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .section-rule-link {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    transition: color 0.15s;
  }

  .section-rule-link:hover { color: var(--accent-alt); }

  /* ── PICKS ─────────────────────────────────────── */
  .picks {
    padding: 3.5rem 0 5rem;
    background: var(--bg);
  }

  .picks-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 3rem;
  }

  .pick-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    transition: background 0.2s;
    overflow: hidden;
  }

  .pick-card:hover {
    background: var(--surface);
  }

  .pick-card--wide {
    grid-column: span 2;
  }

  .pick-image-wrap {
    overflow: hidden;
    aspect-ratio: 3/2;
    background: var(--surface-2);
    flex-shrink: 0;
  }

  .pick-card--wide .pick-image-wrap {
    aspect-ratio: 16/9;
  }

  .pick-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .pick-card:hover .pick-img {
    transform: scale(1.05);
  }

  .pick-img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--surface-2);
  }

  .pick-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .pick-cat {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .pick-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--text);
    margin-bottom: 0.6rem;
    transition: color 0.15s;
  }

  .pick-card--wide .pick-title {
    font-size: 1.4rem;
  }

  .pick-card:hover .pick-title {
    color: var(--accent);
  }

  .pick-desc {
    font-size: 0.8125rem;
    color: var(--text-2);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .pick-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 0.85rem;
    margin-top: auto;
  }

  .pick-date {
    font-size: 0.65rem;
    color: var(--text-3);
    letter-spacing: 0.04em;
  }

  .pick-price {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  /* ── ALL CTA ───────────────────────────────────── */
  .all-cta {
    display: flex;
    justify-content: center;
  }

  .all-cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-2);
    border: 1px solid var(--border-mid);
    padding: 0.85rem 2.5rem;
    transition: color 0.15s, border-color 0.15s;
  }

  .all-cta-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .all-cta-arrow {
    transition: transform 0.2s;
  }

  .all-cta-link:hover .all-cta-arrow {
    transform: translateX(4px);
  }

  /* ── RESPONSIVE ────────────────────────────────── */
  @media (max-width: 960px) {
    .picks-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pick-card--wide {
      grid-column: span 2;
    }
  }

  @media (max-width: 640px) {
    .hero { height: clamp(380px, 65vh, 520px); }

    .hero-content-inner {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .hero-overlay {
      background: linear-gradient(
        to top,
        rgba(10,10,10,0.95) 0%,
        rgba(10,10,10,0.6) 60%,
        rgba(10,10,10,0.2) 100%
      );
    }

    .hero-content {
      align-items: flex-end;
      padding-bottom: 2.5rem;
    }

    .picks-grid {
      grid-template-columns: 1fr;
    }

    .pick-card--wide {
      grid-column: span 1;
    }

    .pick-card--wide .pick-image-wrap {
      aspect-ratio: 3/2;
    }
  }
</style>
