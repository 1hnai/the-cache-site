---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const looks = await getCollection('looks', ({ data }) => data.status === 'live');
  return looks.map((look) => ({
    params: { slug: look.slug },
    props: { look },
  }));
}

const { look } = Astro.props;
const { Content } = await look.render();
const compositeImg = `/looks/${look.slug}.jpg`;
const totalPrice = look.data.items
  .filter((i) => i.price)
  .reduce((sum, i) => {
    const num = parseFloat((i.price || '0').replace(/[^0-9.]/g, ''));
    return sum + (isNaN(num) ? 0 : num);
  }, 0);
const currencySymbol = look.data.items.find((i) => i.price)?.price?.match(/^[^0-9]+/)?.[0] ?? '';
---

<BaseLayout
  title={`${look.data.title} — Looks — The Cache`}
  description={look.data.description ?? `A curated look from The Cache.`}
  article={false}
>
  <style>
    .look-hero {
      background: #fff;
      border-bottom: 1px solid #e5e5e5;
      padding: 3rem 2rem;
    }
    .look-hero-inner {
      max-width: var(--max-width);
      margin: 0 auto;
    }
    .look-breadcrumb {
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #999;
      margin-bottom: 1.5rem;
    }
    .look-breadcrumb a { color: #999; text-decoration: none; }
    .look-breadcrumb a:hover { color: #333; }
    .look-breadcrumb span { margin: 0 0.5rem; }

    .look-composite {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      display: block;
      aspect-ratio: 16/9;
      background: #ffffff;
      object-fit: contain;
    }
    .look-composite-placeholder {
      width: 100%;
      max-width: 960px;
      margin: 0 auto;
      aspect-ratio: 16/9;
      background: #f5f3f0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #bbb;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .look-meta {
      max-width: 960px;
      margin: 2rem auto 0;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .look-meta-left {}
    .look-season {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: #c8973a;
      margin-bottom: 0.5rem;
    }
    .look-title {
      font-family: var(--serif);
      font-size: clamp(1.75rem, 3vw, 2.5rem);
      font-weight: 900;
      color: #111;
      line-height: 1.1;
    }
    .look-total {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #555;
      white-space: nowrap;
    }
    .look-total strong {
      display: block;
      font-size: 1.375rem;
      font-weight: 700;
      color: #111;
      letter-spacing: 0;
    }

    /* Body copy from markdown */
    .look-body {
      background: #fff;
      padding: 2.5rem 2rem;
      border-bottom: 1px solid #e5e5e5;
    }
    .look-body-inner {
      max-width: 640px;
      margin: 0 auto;
      font-size: 0.9375rem;
      color: #444;
      line-height: 1.75;
    }

    /* Item grid */
    .look-items {
      background: var(--surface);
      padding: 3rem 2rem 4rem;
    }
    .look-items-inner {
      max-width: var(--max-width);
      margin: 0 auto;
    }
    .look-items-eyebrow {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--accent);
      margin-bottom: 2rem;
    }
    .look-items-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.25rem;
    }
    .look-item-card {
      background: var(--surface-2);
      border: 1px solid var(--border);
      overflow: hidden;
    }
    .look-item-img {
      width: 100%;
      aspect-ratio: 1;
      background: #fff;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .look-item-img img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      display: block;
      transition: transform 0.3s ease;
    }
    .look-item-card:hover .look-item-img img { transform: scale(1.04); }
    .look-item-body {
      padding: 1rem;
    }
    .look-item-category {
      font-size: 0.575rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--text-3);
      margin-bottom: 0.35rem;
    }
    .look-item-brand {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 0.2rem;
    }
    .look-item-name {
      font-family: var(--serif);
      font-size: 1rem;
      font-weight: 800;
      color: var(--text);
      line-height: 1.2;
      margin-bottom: 0.75rem;
    }
    .look-item-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .look-item-price {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--text-2);
    }
    .look-item-buy {
      display: inline-block;
      font-size: 0.575rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--bg);
      background: var(--accent);
      padding: 0.35rem 0.75rem;
      text-decoration: none;
      transition: background 0.15s;
    }
    .look-item-buy:hover { background: var(--accent-alt); }

    @media (max-width: 640px) {
      .look-hero { padding: 2rem 1.25rem; }
      .look-body { padding: 2rem 1.25rem; }
      .look-items { padding: 2rem 1.25rem 3rem; }
      .look-items-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
      .look-meta { flex-direction: column; gap: 1rem; }
    }
  </style>

  <!-- White hero panel with composite image -->
  <section class="look-hero">
    <div class="look-hero-inner">
      <p class="look-breadcrumb">
        <a href="/looks">Looks</a>
        <span>/</span>
        {look.data.title}
      </p>

      <img
        class="look-composite"
        src={compositeImg}
        alt={look.data.title}
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="look-composite-placeholder" style="display:none;">Image generating</div>

      <div class="look-meta">
        <div class="look-meta-left">
          {look.data.season && <p class="look-season">{look.data.season}</p>}
          <h1 class="look-title">{look.data.title}</h1>
        </div>
        {totalPrice > 0 && (
          <div class="look-total">
            Total
            <strong>{currencySymbol}{totalPrice.toLocaleString('en-GB')}</strong>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Editorial body copy -->
  <section class="look-body">
    <div class="look-body-inner">
      <Content />
    </div>
  </section>

  <!-- Item grid -->
  <section class="look-items">
    <div class="look-items-inner">
      <p class="look-items-eyebrow">The pieces</p>
      <div class="look-items-grid">
        {look.data.items.map((item) => (
          <div class="look-item-card">
            <div class="look-item-img">
              <img src={item.image} alt={`${item.brand} ${item.name}`} loading="lazy" />
            </div>
            <div class="look-item-body">
              <p class="look-item-category">{item.category}</p>
              <p class="look-item-brand">{item.brand}</p>
              <p class="look-item-name">{item.name}</p>
              <div class="look-item-footer">
                {item.price && <span class="look-item-price">{item.price}</span>}
                {item.buyUrl && (
                  <a href={item.buyUrl} target="_blank" rel="noopener noreferrer" class="look-item-buy">
                    Buy
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
