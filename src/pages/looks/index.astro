---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const looks = await getCollection('looks', ({ data }) => data.status === 'live');
looks.sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());
---

<BaseLayout title="Looks — The Cache" description="Curated sets. Every piece chosen with intention.">
  <style>
    .looks-header {
      border-bottom: 1px solid var(--border);
      padding: 4rem 2rem 3rem;
    }
    .looks-header-inner {
      max-width: var(--max-width);
      margin: 0 auto;
    }
    .looks-eyebrow {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--accent);
      margin-bottom: 0.75rem;
    }
    .looks-headline {
      font-family: var(--serif);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 900;
      color: var(--text);
      line-height: 1.1;
      max-width: 540px;
    }
    .looks-subline {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      color: var(--text-2);
      max-width: 420px;
      line-height: 1.6;
    }

    .looks-grid {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 3rem 2rem 5rem;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
      gap: 2rem;
    }

    .look-card {
      background: var(--surface);
      border: 1px solid var(--border);
      overflow: hidden;
      display: block;
      text-decoration: none;
      transition: border-color 0.2s;
    }
    .look-card:hover { border-color: var(--border-mid); }

    .look-card-image {
      width: 100%;
      aspect-ratio: 16/9;
      background: var(--surface-2);
      overflow: hidden;
      position: relative;
    }
    .look-card-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }
    .look-card:hover .look-card-image img {
      transform: scale(1.02);
    }
    .look-card-placeholder {
      width: 100%;
      height: 100%;
      background: var(--surface-2);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-3);
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .look-card-body {
      padding: 1.5rem;
    }
    .look-card-season {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--accent);
      margin-bottom: 0.5rem;
    }
    .look-card-title {
      font-family: var(--serif);
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--text);
      line-height: 1.15;
      margin-bottom: 0.5rem;
    }
    .look-card-desc {
      font-size: 0.8125rem;
      color: var(--text-2);
      line-height: 1.6;
      margin-bottom: 1rem;
    }
    .look-card-items {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
    }
    .look-card-tag {
      font-size: 0.575rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-3);
      background: var(--surface-2);
      border: 1px solid var(--border);
      padding: 0.25rem 0.6rem;
    }
    .look-card-cta {
      margin-top: 1.25rem;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
    }

    @media (max-width: 640px) {
      .looks-header { padding: 2.5rem 1.25rem 2rem; }
      .looks-grid { padding: 2rem 1.25rem 3rem; grid-template-columns: 1fr; gap: 1.25rem; }
    }
  </style>

  <section class="looks-header">
    <div class="looks-header-inner">
      <p class="looks-eyebrow">The Cache — Looks</p>
      <h1 class="looks-headline">Curated sets. Every piece chosen with intention.</h1>
      <p class="looks-subline">Not outfits. Considered groups of objects that work together — and apart.</p>
    </div>
  </section>

  <section class="looks-grid">
    {looks.map((look) => {
      const slug = look.slug;
      const compositeImg = `/looks/${slug}.jpg`;
      return (
        <a href={`/looks/${slug}`} class="look-card">
          <div class="look-card-image">
            {look.data.coverImage || true ? (
              <img
                src={compositeImg}
                alt={look.data.title}
                loading="lazy"
                onerror="this.parentElement.innerHTML='<div class=\'look-card-placeholder\'>Look</div>'"
              />
            ) : (
              <div class="look-card-placeholder">Look</div>
            )}
          </div>
          <div class="look-card-body">
            {look.data.season && <p class="look-card-season">{look.data.season}</p>}
            <h2 class="look-card-title">{look.data.title}</h2>
            {look.data.description && <p class="look-card-desc">{look.data.description}</p>}
            <div class="look-card-items">
              {look.data.items.map((item) => (
                <span class="look-card-tag">{item.category}</span>
              ))}
            </div>
            <p class="look-card-cta">View Look &rarr;</p>
          </div>
        </a>
      );
    })}
  </section>
</BaseLayout>
