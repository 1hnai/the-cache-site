---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  article?: boolean;
  publishedDate?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
  article = false,
  publishedDate,
} = Astro.props;

const siteName = 'The Cache';
const siteUrl = 'https://thecache.com';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:site" content="@thecachecom" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": article ? "Article" : "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": "The best stuff you didn't know you needed.",
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
      :root {
        --brand-bg: #fafafa;
        --brand-surface: #ffffff;
        --brand-surface-2: #f0f0ef;
        --brand-accent: #b45309;
        --brand-accent-hover: #92400e;
        --brand-text: #111111;
        --brand-text-secondary: #555555;
        --brand-muted: #888888;
        --brand-border: #e5e5e5;
        --brand-border-strong: #cccccc;
        --max-width: 1200px;
        --reading-width: 680px;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

      body {
        font-family: var(--font-sans);
        background: var(--brand-bg);
        color: var(--brand-text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: var(--brand-accent); text-decoration: none; }
      a:hover { color: var(--brand-accent-hover); }

      img { display: block; max-width: 100%; }

      /* ── Header ─────────────────────────────────── */
      .site-header {
        border-bottom: 1px solid var(--brand-border);
        background: #ffffff;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .site-header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2rem;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
      }

      .site-logo {
        font-family: var(--font-serif);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--brand-text);
        letter-spacing: -0.01em;
        text-decoration: none;
        flex-shrink: 0;
        line-height: 1;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .site-logo:hover { color: var(--brand-text); }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 0;
      }

      .site-nav a {
        color: var(--brand-muted);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.4rem 0.85rem;
        transition: color 0.15s;
      }

      .site-nav a:hover {
        color: var(--brand-text);
      }

      .site-nav a.active {
        color: var(--brand-accent);
      }

      /* ── Main content ───────────────────────────── */
      main {
        flex: 1;
        width: 100%;
      }

      /* ── Newsletter strip ───────────────────────── */
      .newsletter-strip {
        background: var(--brand-text);
        padding: 4rem 2rem;
      }

      .newsletter-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
      }

      .newsletter-copy h2 {
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin-bottom: 0.5rem;
        line-height: 1.2;
      }

      .newsletter-copy p {
        color: rgba(255,255,255,0.6);
        font-size: 0.9375rem;
        line-height: 1.6;
      }

      .newsletter-form {
        display: flex;
        gap: 0.5rem;
      }

      .newsletter-form input {
        flex: 1;
        padding: 0.75rem 1rem;
        border: 1px solid rgba(255,255,255,0.2);
        background: rgba(255,255,255,0.08);
        color: #ffffff;
        font-size: 0.9rem;
        font-family: var(--font-sans);
        transition: border-color 0.15s;
      }

      .newsletter-form input::placeholder { color: rgba(255,255,255,0.35); }
      .newsletter-form input:focus {
        outline: none;
        border-color: var(--brand-accent);
      }

      .btn {
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        font-size: 0.8125rem;
        cursor: pointer;
        border: none;
        background: var(--brand-accent);
        color: white;
        transition: background 0.15s;
        white-space: nowrap;
        font-family: var(--font-sans);
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .btn:hover {
        background: var(--brand-accent-hover);
      }

      /* ── Footer ─────────────────────────────────── */
      .site-footer {
        border-top: 1px solid var(--brand-border);
        padding: 2rem;
        font-size: 0.8125rem;
        color: var(--brand-muted);
        background: var(--brand-surface);
      }

      .site-footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .site-footer-brand {
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--brand-text);
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .site-footer nav {
        display: flex;
        gap: 1.5rem;
      }

      .site-footer nav a {
        color: var(--brand-muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.7rem;
        font-weight: 500;
        transition: color 0.15s;
      }

      .site-footer nav a:hover { color: var(--brand-text); }

      .site-footer-copy {
        color: var(--brand-muted);
        font-size: 0.75rem;
      }

      /* ── Shared utilities ─────────────────────── */
      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2rem;
      }

      .label {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--brand-accent);
      }

      /* ── Mobile ──────────────────────────────────── */
      @media (max-width: 768px) {
        .site-header-inner { padding: 0 1.25rem; height: 56px; }
        .site-nav a { padding: 0.35rem 0.6rem; font-size: 0.65rem; }
        .newsletter-inner { grid-template-columns: 1fr; gap: 1.5rem; }
        .newsletter-strip { padding: 3rem 1.25rem; }
        .newsletter-form { flex-direction: column; }
        .site-footer-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
        .site-footer { padding: 1.5rem 1.25rem; }
        .container { padding: 0 1.25rem; }
      }

      @media (max-width: 560px) {
        .site-nav {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }
        .site-nav::-webkit-scrollbar { display: none; }
        .site-nav a { white-space: nowrap; }
      }

      @media (max-width: 400px) {
        .site-logo { font-size: 1rem; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/" class="site-logo">The Cache</a>
        <nav class="site-nav">
          <a href="/articles?cat=cars">Cars</a>
          <a href="/articles?cat=watches">Watches</a>
          <a href="/articles?cat=gear">Gear</a>
          <a href="/articles?cat=style">Style</a>
          <a href="/articles?cat=tech">Tech</a>
          <a href="/articles?cat=books">Books</a>
          <a href="/articles?cat=art">Art</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <div class="newsletter-strip">
      <div class="newsletter-inner">
        <div class="newsletter-copy">
          <h2>Get the weekly drop.</h2>
          <p>The best finds, straight to your inbox. No noise, no sponsors, no filler — just the good stuff.</p>
        </div>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="your@email.com" aria-label="Email address" />
          <button class="btn" type="submit">Subscribe</button>
        </form>
      </div>
    </div>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <span class="site-footer-brand">The Cache</span>
        <nav>
          <a href="/articles">All Picks</a>
          <a href="/about">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <span class="site-footer-copy">&copy; {new Date().getFullYear()} The Cache. All rights reserved.</span>
      </div>
    </footer>
  </body>
</html>
