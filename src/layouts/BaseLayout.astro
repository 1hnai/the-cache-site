---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  article?: boolean;
  publishedDate?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogImage = '/og-default.png',
  article = false,
  publishedDate,
} = Astro.props;

const siteName = 'The Cache';
const siteUrl = 'https://thecache.com';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta name="twitter:site" content="@thecachecom" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": article ? "Article" : "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": "The best stuff you didn't know you needed.",
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700;1,800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --bg:         #0a0a0a;
        --surface:    #111111;
        --surface-2:  #1a1a1a;
        --border:     #1f1f1f;
        --border-mid: #2a2a2a;
        --accent:     #c8973a;
        --accent-alt: #e8b84b;
        --text:       #f0ece6;
        --text-2:     #a09890;
        --text-3:     #5a5550;
        --max-width:  1240px;
        --read-width: 680px;
        --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 16px; scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

      body {
        font-family: var(--sans);
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: inherit; text-decoration: none; }
      img { display: block; max-width: 100%; }

      /* ── Ticker ──────────────────────────────────── */
      .ticker-bar {
        background: var(--accent);
        overflow: hidden;
        height: 32px;
        display: flex;
        align-items: center;
      }

      .ticker-track {
        display: flex;
        gap: 0;
        animation: ticker 28s linear infinite;
        white-space: nowrap;
        will-change: transform;
      }

      .ticker-item {
        font-size: 0.625rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: #0a0a0a;
        padding: 0 2.5rem;
      }

      @keyframes ticker {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
      }

      /* ── Header ──────────────────────────────────── */
      .site-header {
        background: var(--bg);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .site-header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2rem;
        height: 72px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 1rem;
      }

      .site-nav-left {
        display: flex;
        align-items: center;
        gap: 0;
      }

      .site-nav-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0;
      }

      .site-logo {
        font-family: var(--serif);
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--text);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        line-height: 1;
        text-align: center;
        transition: color 0.15s;
      }

      .site-logo:hover { color: var(--accent); }

      .site-nav-left a,
      .site-nav-right a {
        color: var(--text-3);
        font-size: 0.625rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        padding: 0.4rem 0.9rem;
        transition: color 0.15s;
      }

      .site-nav-left a:hover,
      .site-nav-right a:hover {
        color: var(--text);
      }

      /* ── Main ────────────────────────────────────── */
      main { flex: 1; width: 100%; }

      /* ── Newsletter ──────────────────────────────── */
      .newsletter-strip {
        border-top: 1px solid var(--border);
        padding: 5rem 2rem;
        background: var(--surface);
      }

      .newsletter-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
      }

      .newsletter-eyebrow {
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 0.75rem;
      }

      .newsletter-copy h2 {
        font-family: var(--serif);
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
        margin-bottom: 0.75rem;
        line-height: 1.15;
      }

      .newsletter-copy p {
        color: var(--text-2);
        font-size: 0.9375rem;
        line-height: 1.7;
      }

      .newsletter-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .newsletter-form input {
        width: 100%;
        padding: 0.9rem 1.25rem;
        border: 1px solid var(--border-mid);
        background: var(--bg);
        color: var(--text);
        font-size: 0.9rem;
        font-family: var(--sans);
        transition: border-color 0.15s;
      }

      .newsletter-form input::placeholder { color: var(--text-3); }
      .newsletter-form input:focus {
        outline: none;
        border-color: var(--accent);
      }

      .btn {
        padding: 0.9rem 1.5rem;
        font-weight: 600;
        font-size: 0.75rem;
        cursor: pointer;
        border: none;
        background: var(--accent);
        color: #0a0a0a;
        transition: background 0.15s;
        white-space: nowrap;
        font-family: var(--sans);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        width: 100%;
      }

      .btn:hover { background: var(--accent-alt); }

      /* ── Footer ──────────────────────────────────── */
      .site-footer {
        background: var(--bg);
        border-top: 1px solid var(--border);
        padding: 2.5rem 2rem;
      }

      .site-footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .site-footer-brand {
        font-family: var(--serif);
        font-size: 0.9rem;
        font-weight: 800;
        color: var(--text-2);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .site-footer nav {
        display: flex;
        gap: 2rem;
      }

      .site-footer nav a {
        color: var(--text-3);
        font-size: 0.625rem;
        font-weight: 500;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        transition: color 0.15s;
      }

      .site-footer nav a:hover { color: var(--text); }

      .site-footer-copy {
        color: var(--text-3);
        font-size: 0.7rem;
        letter-spacing: 0.03em;
      }

      /* ── Shared ──────────────────────────────────── */
      .container {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 2rem;
      }

      .eyebrow {
        font-size: 0.6rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--accent);
      }

      /* ── Mobile ──────────────────────────────────── */
      @media (max-width: 900px) {
        .site-header-inner {
          grid-template-columns: auto 1fr;
          padding: 0 1.25rem;
          height: 60px;
        }
        .site-nav-left { display: none; }
        .site-nav-right { display: none; }
        .site-logo { text-align: left; font-size: 1.25rem; }
        .newsletter-inner { grid-template-columns: 1fr; gap: 2rem; }
        .newsletter-strip { padding: 3.5rem 1.25rem; }
        .site-footer-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
        .site-footer { padding: 2rem 1.25rem; }
        .container { padding: 0 1.25rem; }
        .ticker-item { padding: 0 1.5rem; }
      }
    </style>
  </head>
  <body>

    <!-- Ticker -->
    <div class="ticker-bar" aria-hidden="true">
      <div class="ticker-track">
        {['Gear', 'Watches', 'Cars', 'Tech', 'Style', 'Books', 'Architecture', 'Bikes', 'Culture', 'The Cache',
          'Gear', 'Watches', 'Cars', 'Tech', 'Style', 'Books', 'Architecture', 'Bikes', 'Culture', 'The Cache'].map(item => (
          <span class="ticker-item">{item}</span>
        ))}
      </div>
    </div>

    <!-- Header -->
    <header class="site-header">
      <div class="site-header-inner">
        <nav class="site-nav-left">
          <a href="/articles?cat=gear">Gear</a>
          <a href="/articles?cat=watches">Watches</a>
          <a href="/articles?cat=cars">Cars</a>
        </nav>

        <a href="/" class="site-logo">The Cache</a>

        <nav class="site-nav-right">
          <a href="/articles?cat=tech">Tech</a>
          <a href="/articles?cat=style">Style</a>
          <a href="/looks">Looks</a>
          <a href="/articles">All</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Newsletter -->
    <div class="newsletter-strip">
      <div class="newsletter-inner">
        <div class="newsletter-copy">
          <p class="newsletter-eyebrow">The weekly drop</p>
          <h2>The best finds, straight to your inbox.</h2>
          <p>No noise, no sponsors, no filler — just the good stuff, once a week.</p>
        </div>
        <form class="newsletter-form" onsubmit="return false;">
          <input type="email" placeholder="your@email.com" aria-label="Email address" />
          <button class="btn" type="submit">Subscribe — it's free</button>
        </form>
      </div>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer-inner">
        <span class="site-footer-brand">The Cache</span>
        <nav>
          <a href="/articles">All Picks</a>
          <a href="/about">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <span class="site-footer-copy">&copy; {new Date().getFullYear()} The Cache. All rights reserved.</span>
      </div>
    </footer>

  </body>
</html>
